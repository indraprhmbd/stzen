# Local bindings for `wrangler dev`. Copy to `.dev.vars` (gitignored) and fill.
# Values mirror server/.env. Secrets here stay on disk, never commit.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AES_SECRET_KEY=
ENV=staging
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
PAYMENT_APP_BASE_URL=
PAYMENT_ACTIVE_PROVIDER=manual
PAYMENT_DEFAULT_EXPIRY_MINUTES=60
PAYMENT_SUMOPOD_API_KEY=
PAYMENT_SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com/api/v1
PAYMENT_SUMOPOD_METHOD_CODE=QRIS
PAYMENT_SUMOPOD_WEBHOOK_SECRET=
PAYMENT_SUMOPOD_WEBHOOK_TOKEN=
PAYMENT_DUITKU_MERCHANT_CODE=
PAYMENT_DUITKU_API_KEY=
PAYMENT_DUITKU_BASE_URL=
