{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "dev:workers": "wrangler dev",
    "build": "tsc",
    "build:workers": "wrangler deploy --dry-run",
    "deploy": "node scripts/check-secrets.mjs production && wrangler deploy --env production",
    "deploy:staging": "node scripts/check-secrets.mjs staging && wrangler deploy --env staging",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test modules/auth/__tests__/safe-redirect.test.ts shared/lib/notify/__tests__/notify.test.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@supabase/supabase-js": "^2.112.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "jose": "^6.0.11",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@hono/node-server": "^1.14.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.129.0"
  }
}

