{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store-subs-api",
  "main": "./workers-entry.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  // Secrets live in the secret store (wrangler secret put --env ...), never here:
  // SUPABASE_SERVICE_ROLE_KEY, AES_SECRET_KEY, PAYMENT_SUMOPOD_API_KEY,
  // PAYMENT_SUMOPOD_WEBHOOK_SECRET, PAYMENT_SUMOPOD_WEBHOOK_TOKEN,
  // PAYMENT_DUITKU_MERCHANT_CODE, PAYMENT_DUITKU_API_KEY
  // Top-level vars serve `wrangler dev` only. NEVER bare `wrangler deploy`
  // (it would ship dev CORS + empty return URL under the prod name) — always
  // `npm run deploy` (pins --env production) or `--env staging`.
  "vars": {
    "SUPABASE_URL": "https://kqgfbmehepanzkhypzdw.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_cMvmKGQMAiqy2-xGpaU3xA_QJO-qUKi",
    "ENV": "staging",
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://collected-ankle-dynamic.ngrok-free.dev",
    "PAYMENT_APP_BASE_URL": "",
    "PAYMENT_ACTIVE_PROVIDER": "manual",
    "PAYMENT_SUMOPOD_METHOD_CODE": "QRIS",
    "PAYMENT_DUITKU_BASE_URL": ""
  },
  "env": {
    "production": {
      "vars": {
        "SUPABASE_URL": "https://kqgfbmehepanzkhypzdw.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_cMvmKGQMAiqy2-xGpaU3xA_QJO-qUKi",
        "ENV": "production",
        "CORS_ALLOWED_ORIGINS": "https://stzen.web.id",
        "PAYMENT_APP_BASE_URL": "https://stzen.web.id",
        "PAYMENT_ACTIVE_PROVIDER": "manual",
    "PAYMENT_SUMOPOD_METHOD_CODE": "QRIS",
    "PAYMENT_DUITKU_BASE_URL": ""
      },
      "routes": [{ "pattern": "api.stzen.web.id", "custom_domain": true }]
    },
    "staging": {
      "vars": {
        "SUPABASE_URL": "https://kqgfbmehepanzkhypzdw.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_cMvmKGQMAiqy2-xGpaU3xA_QJO-qUKi",
        "ENV": "staging",
        "CORS_ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://dev.stzen.web.id",
        "PAYMENT_APP_BASE_URL": "https://dev.stzen.web.id",
        "PAYMENT_ACTIVE_PROVIDER": "manual",
    "PAYMENT_SUMOPOD_METHOD_CODE": "QRIS",
    "PAYMENT_DUITKU_BASE_URL": ""
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
