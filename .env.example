# ─── Backend (server/.env) ────────────────────────────────────────────────────

# Database - Transaction Pooler (runtime) + Direct (migrations)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=" "
DATABASE_DIRECT_URL="postgres://postgres.[ref]:[password]@aws-0-[region].supabase.co:5432/postgres"

# Supabase
SUPABASE_URL=""
SUPABASE_ANON_KEY="ey..."
SUPABASE_SERVICE_ROLE_KEY="ey..."

# Encryption (Epic 2)
AES_SECRET_KEY=""

# Payment Gateway (payments scaffold, 2026-09-04)
# manual keeps today's blind-approve flow working with zero config.
# Switch to duitku or sumopod once sandbox credentials are issued.
PAYMENT_ACTIVE_PROVIDER=manual
PAYMENT_APP_BASE_URL="http://localhost:3000"
PAYMENT_DEFAULT_EXPIRY_MINUTES=60

# Duitku (Pop redirect flavor) - sandbox
PAYMENT_DUITKU_MERCHANT_CODE=""
PAYMENT_DUITKU_API_KEY=""
PAYMENT_DUITKU_BASE_URL="https://api-sandbox.duitku.com"

# SumoPod - sandbox (pre-KYC)
PAYMENT_SUMOPOD_API_KEY=""
PAYMENT_SUMOPOD_BASE_URL="https://api-pay-sandbox.sumopod.com/api/v1"
PAYMENT_SUMOPOD_WEBHOOK_SECRET=""
PAYMENT_SUMOPOD_WEBHOOK_TOKEN=""
# Sandbox onboarding only: 1 = log test deliveries + answer 200, trust nothing.
# Auto-capture also applies while BOTH secret and token are empty.
PAYMENT_SUMOPOD_CAPTURE=""

# ─── Frontend (client/.env) ──────────────────────────────────────────────────

VITE_API_BASE_URL="http://localhost:3000"
VITE_SUPABASE_URL="https://[ref].supabase.co"
VITE_SUPABASE_ANON_KEY="ey..."
VITE_WHATSAPP_NUMBER="6281234567890"
